<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>fess-webapp-mcp</artifactId>
	<packaging>jar</packaging>
	<name>MCP Webapp Plugin</name>
	<version>15.9.0-SNAPSHOT</version>
	<scm>
		<connection>scm:git:git@github.com:codelibs/fess-webapp-mcp.git</connection>
		<developerConnection>scm:git:git@github.com:codelibs/fess-webapp-mcp.git</developerConnection>
		<url>https://github.com/codelibs/fess-webapp-mcp</url>
	  <tag>HEAD</tag>
  </scm>
	<parent>
		<groupId>org.codelibs.fess</groupId>
		<artifactId>fess-parent</artifactId>
		<version>15.9.0-SNAPSHOT</version>
		<relativePath />
	</parent>
	<properties>
		<!-- The version oauth2-oidc-sdk 11.38.2 resolves, i.e. what Fess used to supply. -->
		<nimbus.jose.jwt.version>10.9.1</nimbus.jose.jwt.version>
	</properties>
	<build>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
			<plugin>
				<artifactId>maven-source-plugin</artifactId>
			</plugin>
			<plugin>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<!--
						  Writes Implementation-Title/Version into the manifest. server/discover
						  reports _meta.serverInfo.version from
						  getClass().getPackage().getImplementationVersion(), which is null without
						  this, so every result self-reported "unknown". Verified to survive Fess's
						  mounting of WEB-INF/plugin jars as a CLASSES_JAR resource set: Tomcat's
						  WebappClassLoaderBase still reads the archive manifest when defining the
						  package.
						-->
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
						</manifest>
						<manifestEntries>
							<Fess-WebAppJar>true</Fess-WebAppJar>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<!-- No relocation. Nothing else in an installation names these classes:
							     `mvn dependency:list -DincludeGroupIds=com.nimbusds` on Fess 15.9 answers
							     "none", and the built war carries no nimbus-*, oauth2-oidc-sdk-* or jcip-*
							     jar in WEB-INF/lib. OAuthResourceServerAuthenticator resolves
							     com.nimbusds.* by its real name from inside this same jar, so there is no
							     copy to collide with and nothing a rename would buy. -->
							<artifactSet>
								<!-- An include list, not an exclude list: this jar bundles exactly one
								     artifact and must keep doing so if a future dependency arrives. Adding
								     one here has to be a deliberate act, whereas an exclude list silently
								     absorbs whatever the tree grows next.
								     nimbus-jose-jwt is a leaf - `mvn dependency:tree -Dincludes=com.nimbusds`
								     shows it with no children - and is self-contained at run time: it ships
								     jcip-annotations relocated into com.nimbusds.jose.shaded.jcip and gson
								     into com.nimbusds.jose.shaded.gson, and its bytecode contains no
								     reference to net/jcip. Its manifest's Import-Package lists
								     net.jcip.annotations, Bouncy Castle and Google Tink, but every one of
								     those is resolution:=optional and reached only by algorithms this
								     plugin does not accept - newProcessor restricts JWS to RS256, which
								     the JDK's own JCA provides. -->
								<includes>
									<include>com.nimbusds:nimbus-jose-jwt</include>
								</includes>
							</artifactSet>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<!-- Signature files would no longer match the repacked entries. -->
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<!-- nimbus-jose-jwt is Multi-Release and keeps its descriptor at
										     META-INF/versions/9/module-info.class. Shading merges it into a
										     jar whose manifest has no Multi-Release, so it would be dead
										     weight at best; the root-level pattern guards against a future
										     dependency that puts one there, where it would make the jar an
										     automatic module named after a package it no longer owns. -->
										<exclude>module-info.class</exclude>
										<exclude>META-INF/versions/*/module-info.class</exclude>
									</excludes>
								</filter>
							</filters>
							<!-- No ServicesResourceTransformer: `unzip -l` on nimbus-jose-jwt-10.9.1.jar
							     shows no META-INF/services entry, so there is nothing to merge. Add one
							     alongside any future artifact that does ship service files. -->
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-javadoc-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>com.mycila</groupId>
				<artifactId>license-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>net.revelc.code.formatter</groupId>
				<artifactId>formatter-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
	<!-- Fess plugins are distributed through maven.codelibs.org instead of Maven Central.
	     This cannot be inherited from fess-parent: distributionManagement is inherited
	     unconditionally, so declaring it there would also redirect the SNAPSHOT
	     deployments of fess-parent, fess, fess-crawler, fess-crawler-playwright and
	     fess-suggest, which stay on Maven Central. The scpexe transport comes from
	     the wagon-ssh-external build extension inherited from fess-parent. -->
	<distributionManagement>
		<repository>
			<id>codelibs-repo</id>
			<name>CodeLibs Repository</name>
			<url>scpexe://maven.codelibs.org/var/www/maven/release</url>
		</repository>
		<snapshotRepository>
			<id>codelibs-snapshots</id>
			<name>CodeLibs Snapshot Repository</name>
			<url>scpexe://maven.codelibs.org/var/www/maven/snapshot</url>
		</snapshotRepository>
	</distributionManagement>
	<repositories>
		<repository>
			<id>snapshots.central.sonatype.com</id>
			<url>https://central.sonatype.com/repository/maven-snapshots</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>
	<dependencies>
		<dependency>
			<groupId>jakarta.annotation</groupId>
			<artifactId>jakarta.annotation-api</artifactId>
			<version>${jakarta.annotation.api.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<version>${jakarta.servlet.api.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.codelibs</groupId>
			<artifactId>corelib</artifactId>
			<version>${corelib.version}</version>
		</dependency>
		<dependency>
			<groupId>org.lastaflute</groupId>
			<artifactId>lastaflute</artifactId>
			<version>${lastaflute.version}</version>
		</dependency>
		<dependency>
			<groupId>org.dbflute</groupId>
			<artifactId>dbflute-runtime</artifactId>
			<version>${dbflute.version}</version>
		</dependency>
		<dependency>
			<groupId>org.codelibs.fess</groupId>
			<artifactId>fess</artifactId>
			<version>${fess.version}</version>
			<scope>provided</scope>
		</dependency>
		<!-- OAuthResourceServerAuthenticator verifies bearer tokens with Nimbus JOSE + JWT.
		     This used to arrive transitively through Fess, which depended on
		     com.nimbusds:oauth2-oidc-sdk until the SSO authenticators moved out to the
		     fess-sso-* plugins. Declare it directly rather than rely on an accident.
		     Compile scope, not provided: the war supplies none of it, and a plugin jar in
		     WEB-INF/plugin gets no dependency resolution, so it has to be shaded in above.
		     Without that, the DI container fails to start - not merely the oauth path:
		     McpApiManager initialises an OAuthResourceServerAuthenticator field eagerly, and
		     verifying that class loads com.nimbusds.jwt.proc.JWTClaimsSetVerifier, so
		     container.init() dies with NoClassDefFoundError under every mcp.auth.mode,
		     including the default none. -->
		<dependency>
			<groupId>com.nimbusds</groupId>
			<artifactId>nimbus-jose-jwt</artifactId>
			<version>${nimbus.jose.jwt.version}</version>
		</dependency>
		<!-- OAuthResourceServerAuthenticator verifies bearer tokens with Nimbus JOSE + JWT.
		     This used to arrive transitively through Fess, which depended on
		     com.nimbusds:oauth2-oidc-sdk until the SSO authenticators moved out to the
		     fess-sso-* plugins. Declare it directly rather than rely on an accident.
		     Compile scope, not provided: the war supplies none of it, and a plugin jar in
		     WEB-INF/plugin gets no dependency resolution, so it has to be shaded in above.
		     Without that, the DI container fails to start - not merely the oauth path:
		     McpApiManager initialises an OAuthResourceServerAuthenticator field eagerly, and
		     verifying that class loads com.nimbusds.jwt.proc.JWTClaimsSetVerifier, so
		     container.init() dies with NoClassDefFoundError under every mcp.auth.mode,
		     including the default none. -->
		<dependency>
			<groupId>com.nimbusds</groupId>
			<artifactId>nimbus-jose-jwt</artifactId>
			<version>${nimbus.jose.jwt.version}</version>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>${slf4j.version}</version>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<version>${junit.jupiter.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<version>${junit.jupiter.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.dbflute.utflute</groupId>
			<artifactId>utflute-lastaflute</artifactId>
			<version>${utflute.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
